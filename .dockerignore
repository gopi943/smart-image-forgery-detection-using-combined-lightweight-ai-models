.git/
.gitignore
.tmp/
*.log
*.zip

# ── Training data (NOT in production image) ──
datasets/
dataset_harmonized/

# ── ONNX exports (separate concern) ──
exports/

# ── Docker files themselves ──
Dockerfile
docker-compose.yml
.dockerignore

